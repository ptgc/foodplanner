# Minimal version, extended by T-014. Shell scripts and workflow files must keep LF endings,
# otherwise bash fails on Windows checkouts with "\r: command not found".
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.claude/hooks/* text eol=lf
*.bicep text eol=lf
*.bicepparam text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pfx binary
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.json text eol=lf
.editorconfig text eol=lf
