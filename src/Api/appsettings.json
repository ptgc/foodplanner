{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oda": {
    "ClientId": "",
    "WebOrigin": ""
  },
  "Support": {
    "SystemAdminEmails": [],
    "ReadSessionMinutes": 30,
    "WriteSessionMinutes": 15
  },
  "AiImport": {
    "Enabled": false,
