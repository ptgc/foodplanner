{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/verify.sh)",
      "Bash(./scripts/verify.sh *)",
      "Bash(.claude/hooks/test-guard-bash.sh)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet format *)",
      "Bash(dotnet new *)",
      "Bash(dotnet sln *)",
      "Bash(dotnet add *)",
      "Bash(dotnet run *)",
      "Bash(dotnet ef migrations *)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(docker compose *)",
      "Bash(docker build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git merge *)",
      "Bash(git push origin task/*)",
      "Bash(git push -u origin task/*)",
      "Bash(git push origin dev)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sS http://localhost:*)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(./scripts/doctor.sh)",
      "Bash(./scripts/start-orchestrator.sh)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * test)",
      "Bash(git push * prod)",
      "Bash(gh pr merge *)",
      "Bash(gh secret *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/appsettings.*.local.json)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
